# Keep the byte hashes in frozen research snapshots reproducible on Windows.
*.py text eol=lf
*.ps1 text eol=lf
*.md text eol=lf
# Generated JSON includes frozen byte hashes; preserve its original bytes.
/phase2/**/*.json -text whitespace=trailing-space,space-before-tab,cr-at-eol
/phase3/**/*.json -text whitespace=trailing-space,space-before-tab,cr-at-eol
*.csv text eol=lf
/phase3/**/*.csv -text -eol whitespace=trailing-space,space-before-tab,cr-at-eol
*.txt text eol=lf
*.pt binary
*.png binary
*.pdf binary
*.pptx binary
*.ply binary
